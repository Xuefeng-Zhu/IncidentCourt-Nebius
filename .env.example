# Copy to .env.local; never commit real credentials.
INCIDENTCOURT_DATA_MODE=local
SAMPLE_MODE=false
# Existing Zetaris SQL UI origin, not the Cloud Gateway billing/account portal.
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
# Or use an existing account instead of a token:
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Optional identifier namespace with trailing dot, e.g. incidentcourt.
ZETARIS_TABLE_PREFIX=
ZETARIS_ENGINE_ID=
# Nebius Token Factory: opt in only after checking account usage and model availability.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_ALLOW_INFERENCE=0
