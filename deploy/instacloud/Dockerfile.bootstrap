# Provider-free, health-only bootstrap. HTTP cannot initialize the ledger.
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 JUDGE_BOOTSTRAP_HEALTH=1
COPY incidentcourt/__init__.py /app/incidentcourt/__init__.py
COPY incidentcourt/quota.py /app/incidentcourt/quota.py
COPY deploy/instacloud/bootstrap_guard.py /app/deploy/instacloud/bootstrap_guard.py
COPY deploy/instacloud/bootstrap.py /app/deploy/instacloud/bootstrap.py
COPY deploy/instacloud/bootstrap_health.py /app/deploy/instacloud/bootstrap_health.py
RUN useradd --create-home --uid 10001 investigator && chown -R root:root /app && chmod -R a-w /app
USER investigator
EXPOSE 8080
CMD ["python", "-m", "deploy.instacloud.bootstrap_health"]
