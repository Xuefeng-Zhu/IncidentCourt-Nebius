# Rendered only after explicit operator configuration. Do not install as-is.
worker_processes 1;
pid @RUNTIME_DIR@/nginx.pid;
error_log stderr warn;
events { worker_connections 256; }
http {
    access_log off;
    client_body_temp_path @RUNTIME_DIR@/client;
    proxy_temp_path @RUNTIME_DIR@/proxy;
    fastcgi_temp_path @RUNTIME_DIR@/fastcgi;
    uwsgi_temp_path @RUNTIME_DIR@/uwsgi;
    scgi_temp_path @RUNTIME_DIR@/scgi;
    # An aggregate cap, not a per-client rate limit; see README.
    limit_req_zone $server_name zone=incidentcourt_global:1m rate=@EDGE_RPS@r/s;
    server {
        listen [::]:@PORT@ ipv6only=off;
        server_name _;
        client_max_body_size 4k;
        client_body_buffer_size 8k;
        client_body_timeout 10s;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Host $http_host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";
        limit_req_status 429;
        # Narrow GET-only readiness path; verify its need and host behavior on InstaCloud.
        location = /_ready {
            if ($request_method != GET) { return 405; }
            proxy_set_header Host @JUDGE_HOST@;
            proxy_pass http://127.0.0.1:8317/;
        }
        location / {
            limit_req zone=incidentcourt_global burst=@EDGE_BURST@ nodelay;
            proxy_pass http://127.0.0.1:8317;
        }
    }
}
